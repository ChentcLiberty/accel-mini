###################################################################
set sdc_version 2.1

set_units -time ns -resistance MOhm -capacitance fF -voltage V -current mA
set_max_area 0
create_clock [get_ports aclk]  -name clk  -period 10  -waveform {0 5}
set_clock_uncertainty 0.1  [get_clocks clk]
set_input_delay -clock clk  2  [get_ports aresetn]
set_input_delay -clock clk  2  [get_ports {awaddr[11]}]
